# GitHub API 配置 (用于采集 GitHub Stars)
# Token 获取: https://github.com/settings/tokens
# 需要 public_repo 权限即可读取公开仓库信息
# 如果要读取私有仓库，需要 repo 权限
GITHUB_TOKEN=your_github_token_here

# 你的 GitHub 用户名 (用于获取你个人的 star 列表和笔记)
# 如果不设置，将使用公开 API
GITHUB_USERNAME=your_username_here

# X (Twitter) API 配置 (用于采集 Likes 和 Bookmarks)
# 文档: https://developer.x.com/en/docs/authentication/oauth-2-0
#
# 使用 OAuth 2.0 Authorization Code Flow with PKCE
# 1. 在 https://developer.twitter.com/en/portal/dashboard 创建项目和应用
# 2. 启用 OAuth 2.0，设置回调 URL
# 3. 获取 Client ID 和 Client Secret
# 4. 生成 Bearer Token
#
# 所需权限范围 (Scope):
# - tweet.read: 读取推文
# - users.read: 读取用户信息
# - like.read: 读取点赞列表
# - bookmark.read: 读取书签列表
# - offline.access: 获取 refresh token
#
# 获取 User ID: 访问 https://x.com/你的用户名 查看 URL 或 API
X_BEARER_TOKEN=your_bearer_token_here
X_USER_ID=your_user_id_here

# 小红书相关 (未来支持)
# XHS_COOKIE=

# 知乎相关 (未来支持)
# ZHIHU_COOKIE=
